# ─── Environment ────────────────────────────────────────────
NODE_ENV=developement

# ─── MongoDB ────────────────────────────────────────────────
# Replace with your MongoDB Atlas connection string
MONGO_URL=mongodb://mongo:27017/grocery-db

# ─── Server ─────────────────────────────────────────────────
PORT=5000

# ─── JWT ────────────────────────────────────────────────────
# Use a strong random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=your-super-secret-jwt-key

# ─── Admin Credentials ──────────────────────────────────────
# These are the static admin credentials used for the admin login
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Demo@1122

# ─── CORS / Frontend Origins ────────────────────────────────
# Comma-separated list of allowed frontend URLs
ALLOWED_ORIGINS=http://localhost:3000

# ─── Razorpay ───────────────────────────────────────────────
# Get your API keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
